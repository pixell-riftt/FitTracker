@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4"><i class="bi bi-speedometer2"></i> Dashboard</h2>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card p-4 text-center">
            <i class="bi bi-people display-4" style="color: var(--accent-green);"></i>
            <h2 class="mt-2 mb-0">@Model.TotalUsers</h2>
            <p class="text-muted mb-0">Total Users</p>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card p-4 text-center">
            <i class="bi bi-lightning-charge display-4" style="color: var(--accent-brown);"></i>
            <h2 class="mt-2 mb-0">@Model.TotalWorkouts</h2>
            <p class="text-muted mb-0">Total Workouts</p>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card p-4 text-center">
            <i class="bi bi-chat-dots display-4" style="color: var(--accent-yellow);"></i>
            <h2 class="mt-2 mb-0">@Model.TotalComments</h2>
            <p class="text-muted mb-0">Total Comments</p>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card p-4 text-center">
            <i class="bi bi-tags display-4" style="color: var(--accent-green);"></i>
            <h2 class="mt-2 mb-0">@Model.TotalExerciseTypes</h2>
            <p class="text-muted mb-0">Exercise Types</p>
        </div>
    </div>
</div>