@model WorkoutIndexViewModel

<div class="col-md-4 mb-4">
    <div class="card h-100">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="height: 200px; object-fit: cover;" />
        }
        else
        {
            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
            </div>
        }
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@Model.Title</h5>
            <p class="card-text">
                <span class="badge bg-primary"><i class="bi bi-tag"></i> @Model.ExerciseType</span>
                <span class="badge bg-info"><i class="bi bi-clock"></i> @Model.DurationMinutes min</span>
                <span class="badge bg-warning text-dark"><i class="bi bi-heart-fill"></i> @Model.SavedCount</span>
            </p>
            <div class="mt-auto">
                <a asp-controller="Workout" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                    <i class="bi bi-eye"></i> Details
                </a>
                @if (Model.IsAuthor)
                {
                    <a asp-controller="Workout" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-controller="Workout" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                }
                @if (!Model.IsAuthor && !Model.IsSaved)
                {
                    <form asp-controller="Workout" asp-action="Save" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-heart"></i> Save
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>