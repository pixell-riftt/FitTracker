@model UserProfileViewModel

@{
    ViewData["Title"] = Model.DisplayName + "'s Profile";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card p-4">
                <div class="d-flex align-items-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl" alt="@Model.DisplayName"
                             class="rounded-circle me-3" style="width: 80px; height: 80px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle me-3 d-flex align-items-center justify-content-center"
                             style="width: 80px; height: 80px; background-color: var(--accent-green); color: white; font-size: 2rem;">
                            @Model.DisplayName[0].ToString().ToUpper()
                        </div>
                    }
                    <div>
                        <h2 class="mb-0">@Model.DisplayName</h2>
                        <p class="text-muted mb-0">@Model.Email</p>
                    </div>
                    @if ((bool)(ViewBag.IsOwnProfile ?? false))
                    {
                        <a asp-action="Edit" class="btn btn-warning btn-sm ms-auto">
                            <i class="bi bi-pencil"></i> Edit Profile
                        </a>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <div class="mb-4">
                        <h5><i class="bi bi-person-lines-fill"></i> Bio</h5>
                        <p>@Model.Bio</p>
                    </div>
                }

                <div class="row text-center mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="card p-3" style="background-color: var(--bg-primary);">
                            <i class="bi bi-lightning-charge display-6" style="color: var(--accent-green);"></i>
                            <h3 class="mt-2 mb-0">@Model.WorkoutCount</h3>
                            <p class="text-muted mb-0">Workouts</p>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card p-3" style="background-color: var(--bg-primary);">
                            <i class="bi bi-clock display-6" style="color: var(--accent-brown);"></i>
                            <h3 class="mt-2 mb-0">@Model.TotalMinutes</h3>
                            <p class="text-muted mb-0">Total Minutes</p>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Workouts.Any())
            {
                <h4 class="mt-4 mb-3"><i class="bi bi-list-ul"></i> Workouts by @Model.DisplayName</h4>
                <div class="row">
                    @foreach (var workout in Model.Workouts)
                    {
                        <partial name="_WorkoutCardPartial" model="workout" />
                    }
                </div>
            }
        </div>
    </div>
</div>