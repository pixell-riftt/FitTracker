@model UserProfileEditViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card p-4">
                <h2 class="mb-4"><i class="bi bi-pencil"></i> Edit Profile</h2>

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label">Display Name</label>
                        <input asp-for="DisplayName" class="form-control" />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Bio" class="form-label">Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Tell us about yourself..."></textarea>
                        <span asp-validation-for="Bio" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Profile Picture</label>
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ProfileImageUrl" alt="Profile" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;" />
                                <span class="text-muted small ms-2">Current picture</span>
                            </div>
                        }
                        <input type="file" name="ProfileImage" class="form-control" accept="image/*" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Save Profile
                        </button>
                        <a asp-action="View" asp-route-id="" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>