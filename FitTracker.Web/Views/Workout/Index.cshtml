@model PaginatedList<WorkoutIndexViewModel>

@{
    ViewData["Title"] = "Browse Workouts";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-compass"></i> Browse Workouts</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Workout
        </a>
    </div>

    <div class="card p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label"><i class="bi bi-search"></i> Search</label>
                <input type="text" name="searchTerm" class="form-control" placeholder="Search by title..."
                       value="@ViewBag.SearchTerm" />
            </div>
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-tag"></i> Exercise Type</label>
                <select name="exerciseTypeId" class="form-select">
                    <option value="">All Types</option>
                    @if (ViewBag.ExerciseTypes != null)
                    {
                        @foreach (var type in (IEnumerable<ExerciseTypeViewModel>)ViewBag.ExerciseTypes)
                        {
                            <option value="@type.Id" selected="@(ViewBag.SelectedType != null && (int)ViewBag.SelectedType == type.Id)">
                                @type.Name
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </form>
    </div>

    @if (Model.Items.Any())
    {
        <p class="text-muted mb-3">Showing @Model.Items.Count of @Model.TotalCount workout(s) — Page @Model.PageIndex of @Model.TotalPages</p>
        <div class="row">
            @foreach (var workout in Model.Items)
            {
                <partial name="_WorkoutCardPartial" model="workout" />
            }
        </div>

        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PageIndex - 1)"
                           asp-route-searchTerm="@ViewBag.SearchTerm"
                           asp-route-exerciseTypeId="@ViewBag.SelectedType">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchTerm="@ViewBag.SearchTerm"
                           asp-route-exerciseTypeId="@ViewBag.SelectedType">
                            @i
                        </a>
                    </li>
                }

                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.PageIndex + 1)"
                           asp-route-searchTerm="@ViewBag.SearchTerm"
                           asp-route-exerciseTypeId="@ViewBag.SelectedType">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> No workouts found. Try a different search or filter!
        </div>
    }
</div>
