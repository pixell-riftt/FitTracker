@model WorkoutEditViewModel

@{
    ViewData["Title"] = "Edit Workout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card p-4">
                <h2 class="mb-4"><i class="bi bi-pencil"></i> Edit Workout</h2>

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DurationMinutes" class="form-label">Duration (minutes)</label>
                            <input asp-for="DurationMinutes" class="form-control" type="number" />
                            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CreatedOn" class="form-label">Date</label>
                            <input asp-for="CreatedOn" class="form-control" type="date" />
                            <span asp-validation-for="CreatedOn" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExerciseTypeId" class="form-label">Exercise Type</label>
                        <select asp-for="ExerciseTypeId" class="form-select"
                                asp-items="@(new SelectList(Model.ExerciseTypes, "Id", "Name"))">
                        </select>
                        <span asp-validation-for="ExerciseTypeId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Image</label>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImageUrl" alt="Current image" style="max-height: 150px; border-radius: 8px;" />
                                <p class="text-muted small mt-1">Current image</p>
                            </div>
                        }
                        <ul class="nav nav-tabs mb-2" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="tab" href="#uploadTab">Upload New File</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#urlTab">Image URL</a>
                            </li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="uploadTab">
                                <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                            </div>
                            <div class="tab-pane fade" id="urlTab">
                                <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-circle"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>