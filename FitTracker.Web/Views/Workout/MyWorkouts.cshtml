@model IEnumerable<WorkoutIndexViewModel>

@{
    ViewData["Title"] = "My Workouts";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-lines-fill"></i> My Workouts</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Workout
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-lightning-charge display-6" style="color: var(--accent-green);"></i>
                    <h3 class="mt-2 mb-0">@Model.Count()</h3>
                    <p class="text-muted mb-0">Total Workouts</p>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-clock display-6" style="color: var(--accent-brown);"></i>
                    <h3 class="mt-2 mb-0">@Model.Sum(w => w.DurationMinutes)</h3>
                    <p class="text-muted mb-0">Total Minutes</p>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-heart-fill display-6" style="color: var(--accent-yellow);"></i>
                    <h3 class="mt-2 mb-0">@Model.Sum(w => w.SavedCount)</h3>
                    <p class="text-muted mb-0">Total Saves by Others</p>
                </div>
            </div>
        </div>

        <div class="row">
            @foreach (var workout in Model)
            {
                <partial name="_WorkoutCardPartial" model="workout" />
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> You haven't created any workouts yet. Start by adding your first one!
        </div>
    }
</div>