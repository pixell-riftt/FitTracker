@model WorkoutDeleteViewModel

@{
    ViewData["Title"] = "Delete Workout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4 text-center">
                <h2 class="text-danger mb-4"><i class="bi bi-exclamation-triangle"></i> Delete Workout</h2>

                <p class="lead">Are you sure you want to delete this workout?</p>

                <div class="card bg-light p-3 mb-4">
                    <h4>@Model.Title</h4>
                    <p class="text-muted mb-0">Created by: @Model.Author</p>
                </div>

                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Yes, Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>