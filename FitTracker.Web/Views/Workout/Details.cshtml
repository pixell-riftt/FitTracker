@model WorkoutDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="max-height: 400px; object-fit: cover;" />
                }
                <div class="card-body">
                    <h2 class="card-title">@Model.Title</h2>

                    <div class="mb-3">
                        <span class="badge bg-primary"><i class="bi bi-tag"></i> @Model.ExerciseType</span>
                        <span class="badge bg-info"><i class="bi bi-clock"></i> @Model.DurationMinutes min</span>
                        <span class="badge bg-secondary"><i class="bi bi-calendar"></i> @Model.CreatedOn.ToString("MMM dd, yyyy")</span>
                    </div>

                    <p class="text-muted">
                        <i class="bi bi-person"></i> By:
                        <a asp-controller="Profile" asp-action="View" asp-route-id="@Model.AuthorId" style="text-decoration: none;">
                            @Model.Author
                        </a>
                    </p>

                    <hr />

                    <h5>Notes</h5>
                    <p class="card-text">@Model.Notes</p>

                    <hr />

                    <div class="d-flex gap-2">
                        @if (Model.IsAuthor)
                        {
                            <a asp-controller="Workout" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-controller="Workout" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        }
                        @if (!Model.IsAuthor && !Model.IsSaved)
                        {
                            <form asp-controller="Workout" asp-action="Save" asp-route-id="@Model.Id" method="post">
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-heart"></i> Save to Favorites
                                </button>
                            </form>
                        }
                        <a asp-controller="Workout" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-4 p-4">
                <h4 class="mb-3"><i class="bi bi-chat-dots"></i> Comments (@Model.Comments.Count())</h4>

                <form asp-controller="Comment" asp-action="Add" method="post" class="mb-4">
                    <input type="hidden" name="WorkoutId" value="@Model.Id" />
                    <div class="mb-2">
                        <textarea name="Content" class="form-control" rows="3" placeholder="Write a comment..." required minlength="2" maxlength="500"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-send"></i> Post Comment
                    </button>
                </form>

                @if (Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="card mb-2 p-3" style="background-color: var(--bg-primary);">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>
                                        <a asp-controller="Profile" asp-action="View" asp-route-id="@comment.AuthorId" style="text-decoration: none;">
                                            @comment.AuthorName
                                        </a>
                                    </strong>
                                    <small class="text-muted ms-2">@comment.CreatedOn.ToString("MMM dd, yyyy HH:mm")</small>
                                    <p class="mb-0 mt-1">@comment.Content</p>
                                </div>
                                @if (comment.AuthorId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value || User.IsInRole("Admin"))
                                {
                                    <form asp-controller="Comment" asp-action="Delete" method="post">
                                        <input type="hidden" name="id" value="@comment.Id" />
                                        <input type="hidden" name="workoutId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center">No comments yet. Be the first to comment!</p>
                }
            </div>
        </div>
    </div>
</div>