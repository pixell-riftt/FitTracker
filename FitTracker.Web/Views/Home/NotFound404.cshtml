@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card p-5">
                <i class="bi bi-exclamation-triangle display-1" style="color: var(--accent-yellow);"></i>
                <h1 class="display-4 mt-3">404</h1>
                <h3>Page Not Found</h3>
                <p class="text-muted mt-3">
                    The page you're looking for doesn't exist or has been moved.
                </p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house"></i> Go Home
                    </a>
                    <a asp-controller="Workout" asp-action="Index" class="btn btn-outline-secondary ms-2">
                        <i class="bi bi-compass"></i> Browse Workouts
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>