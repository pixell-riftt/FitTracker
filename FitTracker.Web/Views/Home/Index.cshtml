@{
    ViewData["Title"] = "Welcome";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="hero-section text-center">
    <div class="container">
        <h1 class="display-3 fw-bold mb-4">
            <i class="bi bi-lightning-charge-fill"></i> FitTracker
        </h1>
        <p class="lead mb-4">Track your workouts, stay motivated, and reach your fitness goals.</p>
        <div>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-light btn-lg me-2">
                <i class="bi bi-person-plus"></i> Get Started
            </a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </a>
        </div>
    </div>
</section>

<section class="container my-5">
    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <div class="card p-4 h-100">
                <i class="bi bi-journal-plus display-4 mb-3" style="color: var(--accent-green);"></i>
                <h4>Log Workouts</h4>
                <p class="text-muted">Create and track your daily workouts with detailed notes and duration.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card p-4 h-100">
                <i class="bi bi-tags display-4 mb-3" style="color: var(--accent-brown);"></i>
                <h4>Categorize</h4>
                <p class="text-muted">Organize workouts by type — Cardio, Strength, HIIT, Yoga, and more.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card p-4 h-100">
                <i class="bi bi-heart display-4 mb-3" style="color: var(--accent-yellow);"></i>
                <h4>Save Favorites</h4>
                <p class="text-muted">Bookmark the workouts you love and access them anytime.</p>
            </div>
        </div>
    </div>
</section>